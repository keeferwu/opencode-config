{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nord"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "keybinds": {
    "app.exit": "<leader>q",
    "prompt.history.previous": "ctrl+up",
    "prompt.history.next": "ctrl+down"
  }
}
