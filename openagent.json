{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "OpenAgent",
  "mcp": {
    "gitlab": {
      "type": "local",
      "command": ["npx", "-y", "@zereight/mcp-gitlab"],
      "environment": {
        "GITLAB_API_URL": "http://gitlab.nettech-global.com/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "your-personal-access-token",
        "GITLAB_READ_ONLY_MODE": "false",
        "USE_GITLAB_WIKI": "false",
        "USE_MILESTONE": "false",
        "USE_PIPELINE": "false"
      },
      "enabled": false
    }
  }
}
