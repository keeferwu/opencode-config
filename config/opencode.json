{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": false,
  "instructions": ["CONTRIBUTING.md", "docs/rule.md", "~/.config/opencode/rules/*.md"],
  "watcher": {
    "ignore": ["node_modules/**", ".clangd/**", ".cache/**", ".git/**", "*.log"]
  },
  "agent": {
    "code-simplifier": {
      "mode": "subagent"
    },
    "lang-translation": {
      "mode": "subagent"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    }
  },
  "plugin": ["@tarquinen/opencode-dcp@latest", "opencode-lazy-loader"]
}
