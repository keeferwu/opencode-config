{
  "$schema": "https://opencode.ai/config.json",
  "theme": "palenight",
  "share": "manual",
  "autoupdate": false,
  "instructions": ["CONTRIBUTING.md", "docs/rule.md", "~/.config/opencode/rules/*.md"],
  "watcher": {
    "ignore": ["node_modules/**", ".clangd/**", ".cache/**", ".git/**", "*.log"]
  },
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "agent": {
    "code-simplifier": {
      "mode": "subagent"
    },
    "lang-translation": {
      "mode": "subagent"
    }
  },
  "permission": {
    "skill": "ask"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "your-context7-api-key"
      },
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    }
  }
}
