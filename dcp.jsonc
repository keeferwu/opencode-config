{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // ========== 基础设置 ==========
  "enabled": true,                    // 启用/禁用插件
  "autoUpdate": true,                 // 自动更新 npm 安装的 DCP
  "debug": false,                     // 启用调试日志
  "pruneNotification": "detailed",    // 通知级别: "off" | "minimal" | "detailed"
  "pruneNotificationType": "chat",    // 通知类型: "chat" | "toast"

  // ========== 斜杠命令 ==========
  "commands": {
    "enabled": true,                  // 启用 /dcp 命令
    "protectedTools": []              // 保护不被裁剪的工具（支持 glob: "mcp_*"）
  },

  // ========== 手动模式 ==========
  "manualMode": {
    "enabled": false,                 // 启用手动模式（禁用自主上下文管理）
    "automaticStrategies": true       // 手动模式下仍自动运行去重/错误清理
  },

  // ========== 轮次保护 ==========
  "turnProtection": {
    "enabled": false,                 // 启用轮次保护
    "turns": 4                        // 保护最近 N 轮的工具输出
  },

  // ========== 实验性设置 ==========
  "experimental": {
    "allowSubAgents": false,          // 允许子代理中处理 DCP
    "customPrompts": false            // 启用自定义提示词覆盖
  },

  // ========== 保护文件模式 ==========
  "protectedFilePatterns": [],        // glob 模式保护文件不被裁剪

  // ========== 压缩工具配置 ==========
  "compress": {
    "mode": "range",                  // 压缩模式: "range" | "message"（实验性）
    "permission": "allow",            // 权限: "allow" | "ask" | "deny"
    "showCompression": true,         // 在通知中显示压缩内容
    "summaryBuffer": true,            // 摘要 token 扩展有效上限

    // 上下文限制
    "maxContextLimit": "80%",           // 软上限（数字或 "X%"）
    "minContextLimit": "50%",           // 软下限（数字或 "X%"）
    "modelMaxLimits": {},             // 按模型覆盖上限 {"provider/model": 120000}
    "modelMinLimits": {},             // 按模型覆盖下限

    // 提醒控制
    "nudgeFrequency": 5,              // 提醒频率（1=每次, 5=每5次）
    "iterationNudgeThreshold": 15,    // 迭代提醒阈值（消息数）
    "nudgeForce": "soft",             // 提醒力度: "strong" | "soft"

    // 保护设置
    "protectedTools": [],             // 压缩时保留输出的工具
    "protectTags": false,             // 保护 <protect>...</protect> 内容
    "protectUserMessages": true      // 保护用户消息不被压缩
  },

  // ========== 自动清理策略 ==========
  "strategies": {
    "deduplication": {
      "enabled": true,                // 去重相同工具调用
      "protectedTools": []            // 排除的工具
    },
    "purgeErrors": {
      "enabled": true,                // 清理错误工具输入
      "turns": 4,                     // 错误后 N 轮清理
      "protectedTools": []            // 排除的工具
    }
  }
}
