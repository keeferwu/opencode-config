{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": false,
  "lsp": true,
  "instructions": [
    "CONTRIBUTING.md",
    "docs/rule.md",
    "~/.config/opencode/rules/*.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".clangd/**",
      ".cache/**",
      ".git/**",
      "*.log"
    ]
  },
  "permission": {
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git *": "allow",
      "git push": "deny"
    },
    "skill": {
      "*": "allow",
      "markitdown": "deny"
    }
  },
  "agent": {
    "code-simplifier": {
      "mode": "subagent"
    },
    "lang-translation": {
      "mode": "subagent"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
        "X-Anysearch-Client": "mcp/1.0.0"
      },
      "oauth": false,
      "enabled": false
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "plugin": [
    //"opencode-skill-creator@latest",
    "@tarquinen/opencode-dcp@latest"
  ]
}
