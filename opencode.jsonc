{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": false,
  "instructions": [
    "CONTRIBUTING.md",
    "docs/rule.md",
    "~/.opencode/rules/*.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".clangd/**",
      ".cache/**",
      ".git/**",
      "*.log"
    ]
  },
  "permission": {
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git *": "allow",
      "git push": "deny"
    }
  },
  "agent": {
    "code-simplifier": {
      "mode": "subagent"
    },
    "lang-translation": {
      "mode": "subagent"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "headers": {
        "Authorization": "Bearer ${ANYSEARCH_API_KEY}"
      },
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    }
  },
  "plugin": [
    //"opencode-mem@latest",
    "opencode-skill-creator@latest",
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
