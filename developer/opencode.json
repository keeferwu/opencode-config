{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "OpenAgent",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push": "deny",
      "npm *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "chmod *": "ask"
    }
  },
  "mcp": {
    "gitlab": {
      "type": "local",
      "command": ["npx", "-y", "@zereight/mcp-gitlab"],
      "environment": {
        "GITLAB_API_URL": "http://gitlab.nettech-global.com/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_READ_ONLY_MODE": "false",
        "USE_GITLAB_WIKI": "false",
        "USE_MILESTONE": "false",
        "USE_PIPELINE": "false"
      },
      "enabled": false
    }
  }
}
